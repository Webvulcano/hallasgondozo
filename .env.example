# Visszahívás form értesítés
# Töltsd ki és nevezd át .env.local-ra

# Resend API key (https://resend.com)
RESEND_API_KEY=

# Címzett email — kollégák ide kapják a visszahívás kéréseket
NOTIFY_EMAIL=info@ertedhallasgondozo.hu

# Feladó cím (verifikált domain szükséges Resend-ben)
FROM_EMAIL=noreply@ertedhallasgondozo.hu
